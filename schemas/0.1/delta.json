{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/delta.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1"
    },
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "from_exclusive": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "through": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "op": {
                "const": "upsert"
              },
              "resource": {
                "$ref": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/resource.json"
              }
            },
            "required": [
              "seq",
              "op",
              "resource"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "op": {
                "const": "delete"
              },
              "ref": {
                "$ref": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/ref.json"
              }
            },
            "required": [
              "seq",
              "op",
              "ref"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "more": {
      "type": "boolean"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "format": "uri"
      }
    },
    "critical_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "epoch",
    "from_exclusive",
    "through",
    "events",
    "more"
  ],
  "additionalProperties": false
}
