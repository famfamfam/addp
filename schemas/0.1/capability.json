{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/capability.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "format": "uri",
      "pattern": "^https://"
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "url",
        "sha256"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "url",
        "sha256"
      ],
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 16
    },
    "binding": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "format": "uri",
          "pattern": "^https://"
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "protocol",
        "protocol_version",
        "endpoint",
        "operation"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "format": "uri"
      }
    },
    "critical_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "id",
    "profile",
    "revision",
    "input_schema",
    "output_schema",
    "effects",
    "binding"
  ],
  "additionalProperties": false
}
