{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/manifest.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1"
    },
    "protocol": {
      "const": "addp"
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "format": "uri",
      "pattern": "^https://"
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "core/0.1",
          "offer-search/0.1"
        ]
      },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "feed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "format": "uri",
      "pattern": "^https://"
    },
    "capability_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "format": "uri",
        "pattern": "^https://"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "query": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "format": "uri",
          "pattern": "^https://"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "maxItems": 8
        },
        "text_modes": {
          "const": [
            "lexical"
          ]
        },
        "max_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "endpoint",
        "profiles",
        "text_modes",
        "max_limit"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "format": "uri"
      }
    },
    "critical_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "protocol",
    "origin",
    "profiles",
    "capability_documents"
  ],
  "additionalProperties": false
}
