{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/resource.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1"
    },
    "ref": {
      "$ref": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/ref.json"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "format": "uri",
      "pattern": "^https://"
    },
    "profile": {
      "enum": [
        "core/0.1",
        "offer-search/0.1"
      ]
    },
    "revision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "facts": {
      "type": "object",
      "maxProperties": 64
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "format": "uri",
        "pattern": "^https://"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "format": "uri"
      }
    },
    "critical_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "ref",
    "type",
    "profile",
    "revision",
    "facts",
    "capabilities",
    "valid_until"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "offer-search/0.1"
          }
        }
      },
      "then": {
        "properties": {
          "facts": {
            "$ref": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/offer-facts.json"
          },
          "type": {
            "const": "https://schema.org/Offer"
          }
        }
      }
    }
  ]
}
