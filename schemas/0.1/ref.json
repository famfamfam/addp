{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/ref.json",
  "type": "object",
  "properties": {
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "format": "uri",
      "pattern": "^https://"
    },
    "namespace": {
      "enum": [
        "addp",
        "ucp.catalog"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "publisher",
    "namespace",
    "id"
  ],
  "additionalProperties": false
}
