{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/query.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.1"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "text": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "mode",
            "value"
          ],
          "additionalProperties": false
        },
        "where": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "op": {
                "enum": [
                  "eq",
                  "in",
                  "gte",
                  "lte"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                ]
              }
            },
            "required": [
              "field",
              "op",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        },
        "select": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "extensions": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "format": "uri"
          }
        },
        "critical_extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "profile",
        "where",
        "select",
        "limit"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.1"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "extensions": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "format": "uri"
          }
        },
        "critical_extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "cursor"
      ],
      "additionalProperties": false
    }
  ]
}
