{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/offer-facts.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "unit_price_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "condition": {
      "enum": [
        "new",
        "used",
        "refurbished"
      ]
    },
    "colour": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "availability": {
      "enum": [
        "in_stock",
        "out_of_stock",
        "unknown"
      ]
    },
    "gtin": {
      "type": "string",
      "pattern": "^[0-9]{8,14}$"
    }
  },
  "required": [],
  "additionalProperties": false,
  "dependentRequired": {
    "unit_price_minor": [
      "currency"
    ],
    "currency": [
      "unit_price_minor"
    ]
  }
}
