{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/result.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1"
    },
    "snapshot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/candidate.json"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "format": "uri"
      }
    },
    "critical_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "snapshot",
    "items",
    "next_cursor"
  ],
  "additionalProperties": false
}
