{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/famfamfam/addp/main/schemas/0.1/head.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1"
    },
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "through": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "format": "uri",
            "pattern": "^https://"
          },
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "through",
        "parts",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "changes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "format": "uri",
      "pattern": "^https://"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "format": "uri"
      }
    },
    "critical_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "epoch",
    "snapshot"
  ],
  "additionalProperties": false
}
